.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: linear-gradient(180deg, #111927 0%, #172335 50%, #101723 100%);
}

.hud {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.hud-item {
  min-width: 0;
  padding: 14rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}

.label,
.value {
  display: block;
  text-align: center;
}

.label {
  color: #aeb8c8;
  font-size: 22rpx;
}

.value {
  margin-top: 4rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.canvas-shell {
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 8rpx;
  background: #162132;
  box-shadow: 0 18rpx 60rpx rgba(0, 0, 0, 0.25);
}

.battlefield {
  display: block;
  width: 100%;
  height: 820rpx;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 18rpx;
}

.tower-button {
  width: 49%;
  min-width: 0;
  margin-bottom: 12rpx;
  padding: 12rpx 4rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #edf2ff;
  line-height: 1.2;
}

.tower-button.active {
  border-color: #6ee7b7;
  background: rgba(110, 231, 183, 0.16);
}

.tower-arrow {
  border-color: rgba(248, 250, 252, 0.32);
}

.tower-rocket {
  border-color: rgba(249, 115, 22, 0.38);
}

.tower-barracks {
  border-color: rgba(34, 197, 94, 0.38);
}

.tower-magic {
  border-color: rgba(167, 139, 250, 0.38);
}

.tower-icon,
.tower-name,
.tower-cost {
  display: block;
}

.tower-icon {
  font-size: 36rpx;
}

.tower-name {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.tower-cost {
  margin-top: 4rpx;
  color: #b8c4d8;
  font-size: 20rpx;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.primary,
.secondary,
.upgrade {
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.primary {
  background: #2563eb;
}

.secondary {
  background: #475569;
}

.upgrade {
  width: 220rpx;
  margin-top: 14rpx;
  background: #059669;
}

.panel {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}

.panel-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.panel-text {
  margin-top: 8rpx;
  color: #b8c4d8;
  font-size: 24rpx;
  line-height: 1.45;
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(5, 10, 18, 0.78);
}

.game-over-card {
  width: 100%;
  max-width: 620rpx;
  padding: 34rpx 28rpx 30rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(248, 113, 113, 0.45);
  border-radius: 8rpx;
  background: #182231;
  box-shadow: 0 28rpx 90rpx rgba(0, 0, 0, 0.45);
}

.game-over-title {
  color: #fecaca;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 0;
  text-align: center;
}

.game-over-subtitle {
  margin-top: 8rpx;
  color: #cbd5e1;
  font-size: 26rpx;
  text-align: center;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 26rpx;
}

.result-item {
  width: 48%;
  margin-bottom: 14rpx;
  padding: 16rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}

.result-label,
.result-value {
  display: block;
  text-align: center;
}

.result-label {
  color: #aeb8c8;
  font-size: 22rpx;
}

.result-value {
  margin-top: 4rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.restart {
  margin-top: 16rpx;
  border-radius: 8rpx;
  background: #dc2626;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}
